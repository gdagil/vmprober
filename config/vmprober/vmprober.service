[Unit]
Description=VMProber - Multi-protocol endpoint prober
Documentation=https://github.com/gdagil/vmprober
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmprober
Group=vmprober
ExecStart=/usr/bin/vmprober -config /etc/vmprober/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/vmprober /var/log/vmprober

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmprober

[Install]
WantedBy=multi-user.target
