# VMProber Configuration
# Generated by Ansible role: vmprober-config
# This configuration includes probes for all nodes from inventory

# HTTP server
listen:
  port: 8429
  host: "0.0.0.0"
  tls:
    enabled: false

# Pull mode (Prometheus scrape)
pull:
  enabled: true
  path: "/metrics"
  timeout: 10s

# Push mode (VictoriaMetrics)
push:
  enabled: {{ (vmprober_config.push.enabled | default(true)) if vmprober_config is defined else true }}
  endpoints:
{% if vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.endpoints is defined %}
{% for endpoint in vmprober_config.push.endpoints %}
    - url: "{{ endpoint.url }}"
      headers: {{ endpoint.headers | default({}) | to_nice_yaml(indent=8) | indent(6, first=True) }}
      auth:
        type: "{{ endpoint.auth.type | default('none') }}"
{% if endpoint.auth.type == 'basic' %}
        username: "{{ endpoint.auth.username }}"
        password: "{{ endpoint.auth.password }}"
{% elif endpoint.auth.type == 'bearer' %}
        token: "{{ endpoint.auth.token }}"
{% endif %}
{% endfor %}
{% else %}
    - url: "http://localhost:8480/insert/0/prometheus/api/v1/import"
      headers: {}
      auth:
        type: "none"
{% endif %}
  retry:
    max_attempts: {{ (vmprober_config.push.retry.max_attempts | default(5)) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.retry is defined) else 5 }}
    backoff: "{{ (vmprober_config.push.retry.backoff | default('exponential')) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.retry is defined) else 'exponential' }}"
    initial_delay: "{{ (vmprober_config.push.retry.initial_delay | default('1s')) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.retry is defined) else '1s' }}"
    max_delay: "{{ (vmprober_config.push.retry.max_delay | default('60s')) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.retry is defined) else '60s' }}"
    multiplier: {{ (vmprober_config.push.retry.multiplier | default(2.0)) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.retry is defined) else 2.0 }}
  dedup:
    enabled: {{ (vmprober_config.push.dedup.enabled | default(true)) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.dedup is defined) else true }}
    window: "{{ (vmprober_config.push.dedup.window | default('5m')) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.dedup is defined) else '5m' }}"
    keys:
{% if vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.dedup is defined and vmprober_config.push.dedup.keys is defined %}
{% for key in vmprober_config.push.dedup.keys %}
      - "{{ key }}"
{% endfor %}
{% else %}
      - "job"
      - "instance"
      - "probe"
      - "target"
      - "proto"
{% endif %}
  batch:
    size: {{ (vmprober_config.push.batch.size | default(1000)) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.batch is defined) else 1000 }}
    timeout: "{{ (vmprober_config.push.batch.timeout | default('30s')) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.batch is defined) else '30s' }}"
  remote_write:
    enabled: {{ (vmprober_config.push.remote_write.enabled | default(false)) if (vmprober_config is defined and vmprober_config.push is defined and vmprober_config.push.remote_write is defined) else false }}

# Task scheduler
scheduler:
  concurrent: {{ (vmprober_config.scheduler.concurrent | default(100)) if (vmprober_config is defined and vmprober_config.scheduler is defined) else 100 }}
  rps_limit: {{ (vmprober_config.scheduler.rps_limit | default(1000)) if (vmprober_config is defined and vmprober_config.scheduler is defined) else 1000 }}
  per_host_cap: {{ (vmprober_config.scheduler.per_host_cap | default(10)) if (vmprober_config is defined and vmprober_config.scheduler is defined) else 10 }}
  jitter: {{ (vmprober_config.scheduler.jitter | default(0.1)) if (vmprober_config is defined and vmprober_config.scheduler is defined) else 0.1 }}
  timeouts:
    tcp: "{{ (vmprober_config.scheduler.timeouts.tcp | default('5s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '5s' }}"
    udp: "{{ (vmprober_config.scheduler.timeouts.udp | default('3s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '3s' }}"
    icmp: "{{ (vmprober_config.scheduler.timeouts.icmp | default('2s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '2s' }}"
    http: "{{ (vmprober_config.scheduler.timeouts.http | default('10s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '10s' }}"
    https: "{{ (vmprober_config.scheduler.timeouts.https | default('10s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '10s' }}"
    dns: "{{ (vmprober_config.scheduler.timeouts.dns | default('5s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '5s' }}"
    grpc: "{{ (vmprober_config.scheduler.timeouts.grpc | default('10s')) if (vmprober_config is defined and vmprober_config.scheduler is defined and vmprober_config.scheduler.timeouts is defined) else '10s' }}"
  queue_size: {{ (vmprober_config.scheduler.queue_size | default(10000)) if (vmprober_config is defined and vmprober_config.scheduler is defined) else 10000 }}
  worker_timeout: "{{ (vmprober_config.scheduler.worker_timeout | default('30s')) if (vmprober_config is defined and vmprober_config.scheduler is defined) else '30s' }}"

# Target management
targets:
  static:
    # ===== Auto-generated probes for inventory nodes =====
    # TCP probes on vmprober port (8429) for all nodes
{% if groups['vmprober'] is defined %}
{% for host in groups['vmprober'] %}
{% set host_vars = hostvars[host] %}
{% set host_ip = host_vars.ansible_host | default(host_vars.inventory_hostname) %}
{% set host_name = host %}
    # TCP probe for {{ host_name }} ({{ host_ip }})
    - host: "{{ host_ip }}"
      port: {{ vmprober_tcp_probe_port | default(8429) }}
      proto: "tcp"
      interval: {{ vmprober_tcp_probe_interval | default('10s') }}
      timeout: {{ vmprober_tcp_probe_timeout | default('5s') }}
      labels:
        node: "{{ host_name }}"
        node_ip: "{{ host_ip }}"
        probe_type: "tcp"
        probe_port: "{{ vmprober_tcp_probe_port | default(8429) }}"

    # ICMP probe for {{ host_name }} ({{ host_ip }})
    - host: "{{ host_ip }}"
      proto: "icmp"
      interval: {{ vmprober_icmp_probe_interval | default('10s') }}
      timeout: {{ vmprober_icmp_probe_timeout | default('2s') }}
      labels:
        node: "{{ host_name }}"
        node_ip: "{{ host_ip }}"
        probe_type: "icmp"

{% endfor %}
{% else %}
    # No vmprober hosts found in inventory
{% endif %}

    # ===== Additional static probes (from vmprober_config.targets.static) =====
{% if vmprober_config is defined and vmprober_config.targets is defined and vmprober_config.targets.static is defined %}
{% for probe in vmprober_config.targets.static %}
    - host: "{{ probe.host }}"
{% if probe.port is defined %}
      port: {{ probe.port }}
{% endif %}
{% if probe.protocols is defined %}
      protocols: {{ probe.protocols | to_nice_yaml(indent=6) | indent(4, first=True) }}
{% else %}
      proto: "{{ probe.proto }}"
{% endif %}
      interval: {{ probe.interval }}
      timeout: {{ probe.timeout }}
      labels: {{ probe.labels | default({}) | to_nice_yaml(indent=6) | indent(4, first=True) }}
{% if probe.http is defined %}
      http:
        method: "{{ probe.http.method }}"
{% if probe.http.path is defined %}
        path: "{{ probe.http.path }}"
{% endif %}
{% if probe.http.expected_status_code is defined %}
        expected_status_code: {{ probe.http.expected_status_code }}
{% endif %}
{% if probe.http.validate_cert is defined %}
        validate_cert: {{ probe.http.validate_cert }}
{% endif %}
{% if probe.http.follow_redirects is defined %}
        follow_redirects: {{ probe.http.follow_redirects }}
{% endif %}
{% if probe.http.body is defined %}
        body: {{ probe.http.body | to_json }}
{% endif %}
{% if probe.http.headers is defined %}
        headers: {{ probe.http.headers | to_nice_yaml(indent=10) | indent(8, first=True) }}
{% endif %}
{% if probe.http.basic_auth is defined %}
        basic_auth:
          username: "{{ probe.http.basic_auth.username }}"
          password: "{{ probe.http.basic_auth.password }}"
{% endif %}
{% if probe.http.bearer_token is defined %}
        bearer_token: "{{ probe.http.bearer_token }}"
{% endif %}
{% if probe.http.proxy is defined %}
        proxy: "{{ probe.http.proxy }}"
{% endif %}
{% endif %}
{% if probe.dns is defined %}
      dns:
{% if probe.dns.query_name is defined %}
        query_name: "{{ probe.dns.query_name }}"
{% endif %}
{% if probe.dns.query_type is defined %}
        query_type: "{{ probe.dns.query_type }}"
{% endif %}
{% if probe.dns.protocol is defined %}
        protocol: "{{ probe.dns.protocol }}"
{% endif %}
{% if probe.dns.validate_answer is defined %}
        validate_answer: {{ probe.dns.validate_answer }}
{% endif %}
{% if probe.dns.recursion is defined %}
        recursion: {{ probe.dns.recursion }}
{% endif %}
{% if probe.dns.expected_records is defined %}
        expected_records: {{ probe.dns.expected_records | to_nice_yaml(indent=10) | indent(8, first=True) }}
{% endif %}
{% endif %}
{% if probe.grpc is defined %}
      grpc:
{% if probe.grpc.service is defined %}
        service: "{{ probe.grpc.service }}"
{% endif %}
{% if probe.grpc.expected_status is defined %}
        expected_status: "{{ probe.grpc.expected_status }}"
{% endif %}
{% if probe.grpc.tls is defined %}
        tls: {{ probe.grpc.tls }}
{% endif %}
{% if probe.grpc.tls_skip_verify is defined %}
        tls_skip_verify: {{ probe.grpc.tls_skip_verify }}
{% endif %}
{% if probe.grpc.server_name is defined %}
        server_name: "{{ probe.grpc.server_name }}"
{% endif %}
{% if probe.grpc.metadata is defined %}
        metadata: {{ probe.grpc.metadata | to_nice_yaml(indent=10) | indent(8, first=True) }}
{% endif %}
{% endif %}

{% endfor %}
{% endif %}
